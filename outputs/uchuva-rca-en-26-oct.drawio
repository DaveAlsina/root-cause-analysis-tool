<UserObject label="manual process" status="unassessed" id="n76"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2482" y="1400" width="115" height="33" as="geometry"/></mxCell></UserObject>
<UserObject label="1–3 days of processing time" status="unassessed" id="n77"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1ba1e2;strokeColor=#006eaf;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="769" y="1385" width="157" height="50" as="geometry"/></mxCell></UserObject>
<UserObject label="high utilization of sorting and grading lines for other fruits" status="unassessed" id="n78"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1003" y="1332" width="166" height="67" as="geometry"/></mxCell></UserObject>
<UserObject label="Harvesting takes place during rainy periods" status="unassessed" id="n79"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1ba1e2;strokeColor=#006eaf;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="756" y="1489" width="155" height="50" as="geometry"/></mxCell></UserObject>
<UserObject label="There is strong pressure for product during high-demand periods" status="unassessed" id="n80"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="992" y="1480" width="163" height="67" as="geometry"/></mxCell></UserObject>
<UserObject label="Inadequate crop rotation" status="unassessed" id="n81"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1ba1e2;strokeColor=#006eaf;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="761" y="1716" width="168" height="33" as="geometry"/></mxCell></UserObject>
<UserObject label="Farmers tend to repeatedly grow the crops they already know" status="unassessed" id="n82"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1502" y="1496" width="164" height="67" as="geometry"/></mxCell></UserObject>
<UserObject label="Farmers' knowledge of how to design an adequate crop rotation is limited" status="unassessed" id="n83"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1007" y="1690" width="168" height="84" as="geometry"/></mxCell></UserObject>
<UserObject label="Technical advice focuses on short-term operational aspects" status="unassessed" id="n84"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1ba1e2;strokeColor=#006eaf;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1010" y="1789" width="167" height="67" as="geometry"/></mxCell></UserObject>
<UserObject label="Long-term relationships with physalis growers are complex" status="unassessed" id="n85"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1ba1e2;strokeColor=#006eaf;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1259" y="1610" width="170" height="67" as="geometry"/></mxCell></UserObject>
<UserObject label="Mutual trust issues" status="unassessed" id="n86"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1ba1e2;strokeColor=#006eaf;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1530" y="1577" width="133" height="33" as="geometry"/></mxCell></UserObject>
<UserObject label="Farmer sells to other exporters in parallel" status="unassessed" id="n87"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1745" y="1487" width="143" height="50" as="geometry"/></mxCell></UserObject>
<UserObject label="Farmer sometimes does not properly understand/review the contract" status="unassessed" id="n88"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1745" y="1551" width="163" height="84" as="geometry"/></mxCell></UserObject>
<UserObject label="There are many farmers to visit and support" status="unassessed" id="n89"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1ba1e2;strokeColor=#006eaf;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1259" y="1808" width="162" height="50" as="geometry"/></mxCell></UserObject>
<UserObject label="The supplier changes relatively often" status="unassessed" id="n90"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1ba1e2;strokeColor=#006eaf;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1517" y="1755" width="147" height="50" as="geometry"/></mxCell></UserObject>
<UserObject label="The farmer has little land" status="unassessed" id="n91"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1744" y="1812" width="168" height="33" as="geometry"/></mxCell></UserObject>
<UserObject label="Crop rotation must be at least 4 years" status="unassessed" id="n92"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1744" y="1747" width="164" height="50" as="geometry"/></mxCell></UserObject>
<UserObject label="Lack of trust and transparency in the sorting and grading system" status="unassessed" id="n93"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#1ba1e2;strokeColor=#006eaf;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1769" y="1649" width="135" height="84" as="geometry"/></mxCell></UserObject>
