@article{CaracterizacionCadenaLogistica2025moyano,
	title = {Caracterización de la cadena logística de la uchuva},
	volume = {1},
	issn = {3101-0016},
	url = {https://revistas.umng.edu.co/index.php/sem/article/view/8059},
	doi = {10.18359/31010016.8059},
	abstract = {La uchuva es una fruta exótica valorada en los mercados tanto nacionales como internacionales debido a su alto contenido de vitaminas, antioxidantes y minerales, así como múltiples beneficios para la salud. Por ello, su comercialización representa una oportunidad para el sector agroindustrial, pero la cadena logística de la uchuva enfrenta algunos desafíos que pueden afectar su competitividad y sostenibilidad, como la variabilidad en la calidad del producto, las condiciones de almacenamiento y transporte, la gestión de costos y eficiencia en la distribución. Este estudio se centra en la caracterización de la cadena logística de la uchuva, abarcando todas las etapas del proceso, desde la producción en campo hasta la comercialización en mercados nacionales e internacionales. Se identificarán los actores clave, incluyendo productores, intermediarios, transportistas, exportadores y comercializadores, así como los procesos de cosecha, poscosecha, almacenamiento, transporte y distribución.},
	number = {1},
	journaltitle = {Semilleros {UMNG}},
	shortjournal = {Semilleros {UMNG}},
	author = {Moyano, Valentina and López, Paula},
	urldate = {2026-08-27},
	date = {2025-07-11},
	langid = {spanish},
	keywords = {bad-quality},
	file = {PDF:/home/dave/Zotero/storage/P3XYUHGX/Moyano and López - 2025 - Caracterización de la cadena logística de la uchuva.pdf:application/pdf},
}

